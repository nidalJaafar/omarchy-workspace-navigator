#!/usr/bin/env bash

set -euo pipefail

threshold_ms="${OMARCHY_WORKSPACE_DOUBLE_TAP_MS:-420}"
runtime_dir="${XDG_RUNTIME_DIR:-/tmp}"
state_file="$runtime_dir/nidal-workspace-navigator-super-$UID"
lock_file="$state_file.lock"
now_ms="$(date +%s%3N)"
last_ms=0

exec 9>"$lock_file"
flock -x 9

if [[ -r "$state_file" ]]; then
  read -r last_ms < "$state_file" || last_ms=0
fi

if [[ "$last_ms" =~ ^[0-9]+$ ]] && (( now_ms > last_ms && now_ms - last_ms <= threshold_ms )); then
  : > "$state_file"
  omarchy-shell shell toggle omarchy-overview
else
  printf '%s\n' "$now_ms" > "$state_file"
fi
